{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make",
            "args": [
                "-j8"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "编译 STM32 工程"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "make",
            "args": [
                "clean",
                "&&",
                "make",
                "-j8"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "清除并重新编译"
        },
        {
            "label": "Flash (OpenOCD)",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32f4x.cfg",
                "-c", "program build/${workspaceFolderBasename}.elf verify reset exit"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "烧录固件到 STM32",
            "dependsOn": "Build"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "清除编译产物"
        }
    ]
}
