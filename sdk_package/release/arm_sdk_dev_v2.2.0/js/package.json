{
  "name": "arm-sdk-js",
  "version": "2.0.0",
  "description": "六轴机械臂上位机 SDK（JS）— UDP 网口 / WebSocket 桥 / Web Serial / 离线模拟器，四承载一套协议",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./src/index.js",
