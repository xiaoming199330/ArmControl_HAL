    "./transport": "./src/transport.js",
    "./client": "./src/client.js",
    "./teleop": "./src/teleop.js",
    "./teach": "./src/teach.js",
    "./kinematics": "./src/kinematics.js",
    "./console": "./src/console.js",
    "./sim": "./src/sim.js",
    "./bridge": "./src/bridge.js"
