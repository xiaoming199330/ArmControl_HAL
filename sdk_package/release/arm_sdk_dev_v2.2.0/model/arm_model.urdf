<?xml version="1.0"?>
<!-- ============================================================
     六轴机械臂 URDF（与固件 ArmControl_HAL 运动学完全一致）

     作者：ArmControl_HAL 上位机开发包  |  生成日期：2026-09-14
     权威来源：Core/Inc/kinematics.h（常量）+ Core/Src/kinematics.c（FK 公式）
     自检：POSE_HOME_J 复算 FK = rho 131.39 / z 3.98 / pitch 150.03，与实机 f 打印一致。

     坐标系约定：
       世界系 X=前, Y=左, Z=上；原点 = 桌面上的 J1 轴心；单位 = 米（URDF 标准，故 mm/1000）
       关节角 0 = 官方 Home（上臂 +13.97°、前臂水平 +87.79°）
       工具俯仰 pitch: 0°=竖直向上, 90°=水平向前, 180°=竖直向下

     ⚠ 关节限位说明：J1/J2/J4/J6 的限位由现场标定 'c' 实测决定，此处为固件默认值近似；
       J3/J5 由写死偏移给出（权威）。上位机应以设备实测（'L' 命令）为准并覆盖这些值。
     ⚠ 视觉几何为"示意图元"（盒体），尺寸来自官方 STL 实测包围盒；若需照片级外观，
       请改用 model/official/so101_new_calib.urdf + STL 网格。
     ============================================================ -->
<robot name="arm_so101_hal">

  <!-- ================= 底座（固定于桌面） ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.017130" rpy="0 0 0"/>
      <geometry><cylinder radius="0.036000" length="0.017130"/></geometry>
      <material name="base"><color rgba="0.15 0.17 0.22 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.041215" rpy="0 0 0"/>
      <geometry><cylinder radius="0.028000" length="0.048170"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.032650" rpy="0 0 0"/>
      <geometry><cylinder radius="0.036000" length="0.065300"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.032650" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0018"/>
    </inertial>
  </link>

  <!-- ================= J1 肩部水平旋转 (Yaw, 绕竖直 Z) ================= -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0 0 0.065300" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
      <limit lower="-3.141593" upper="3.141593" effort="10" velocity="10"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0.000000 0.000000 -0.021200" rpy="0 0 0"/>
      <geometry><box size="0.045400 0.024800 0.039600"/></geometry>
      <material name="servo"><color rgba="0.20 0.24 0.32 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0212" rpy="0 0 0"/>
      <geometry><box size="0.045400 0.024800 0.039600"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.008 0 0.02" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="3e-5"/>
    </inertial>
  </link>

  <!-- ================= J2 肩 (Pitch, 绕 Y) ================= -->
  <joint name="shoulder_lift" type="revolute">
    <origin xyz="0.031320 0 0.054800" rpy="0 0 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 1 0"/>
      <limit lower="-2.129302" upper="1.466077" effort="10" velocity="10"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.014000 0 0.056285" rpy="0 0.243787 0"/>
      <geometry><box size="0.045400 0.028000 0.116000"/></geometry>
      <material name="link"><color rgba="0.85 0.85 0.88 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.014000 0 0.056285" rpy="0 0.243787 0"/>
      <geometry><box size="0.045400 0.028000 0.116000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.014000 0 0.056285" rpy="0 0 0"/>
      <mass value="0.14"/>
      <inertia ixx="3e-5" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/>
    </inertial>
  </link>

  <!-- ================= J3 肘 (Pitch, 绕 Y) ================= -->
  <joint name="elbow_flex" type="revolute">
    <origin xyz="0.028000 0 0.112570" rpy="0 0 0"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 1 0"/>
      <limit lower="-1.784455" upper="1.672447" effort="10" velocity="10"/>
  </joint>

  <link name="lower_arm_link">
    <visual>
      <origin xyz="0.067450 0 0.002600" rpy="0 1.532268 0"/>
      <geometry><box size="0.045400 0.028000 0.135000"/></geometry>
      <material name="link"><color rgba="0.85 0.85 0.88 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.067450 0 0.002600" rpy="0 1.532268 0"/>
      <geometry><box size="0.045400 0.028000 0.135000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.067450 0 0.002600" rpy="0 0 0"/>
      <mass value="0.16"/>
      <inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-4" iyz="0" izz="3e-4"/>
    </inertial>
  </link>

  <!-- ================= J4 腕俯仰 (Pitch, 绕 Y) ================= -->
  <joint name="wrist_flex" type="revolute">
    <origin xyz="0.134900 0 0.005200" rpy="0 0 0"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 1 0"/>
      <limit lower="-1.692969" upper="1.902409" effort="10" velocity="10"/>
  </joint>

  <!-- J5 的 frame 沿工具轴：+Z 指向工具方向（零位时 psi=87.79°） -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0.000000 0 0.031250" rpy="0 0.000000 0"/>
      <geometry><box size="0.045400 0.036900 0.062500"/></geometry>
      <material name="link"><color rgba="0.85 0.85 0.88 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.000000 0 0.031250" rpy="0 0.000000 0"/>
      <geometry><box size="0.045400 0.036900 0.062500"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.031250" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ================= J5 腕自转 (Roll, 绕工具轴) ================= -->
  <joint name="wrist_roll" type="revolute">
    <origin xyz="0.062454 0 0.002407" rpy="0 1.532268 0"/>
    <parent link="lower_arm_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
      <limit lower="-1.584989" upper="1.207538" effort="10" velocity="10"/>
  </joint>

  <!-- ================= 夹爪（J5 之后 105.30mm 即 TCP） ================= -->
  <link name="gripper_link">
    <!-- 夹爪基座（舵机） -->
    <visual>
      <origin xyz="0 0 0.0212" rpy="0 0 0"/>
      <geometry><box size="0.045400 0.024800 0.039600"/></geometry>
      <material name="servo"><color rgba="0.20 0.24 0.32 1"/></material>
    </visual>
    <!-- 固定爪 -->
    <visual>
      <origin xyz="0 0.030 0.052650" rpy="0 0 0"/>
      <geometry><box size="0.020 0.010 0.105300"/></geometry>
      <material name="jaw"><color rgba="0.95 0.75 0.20 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.052650" rpy="0 0 0"/>
      <mass value="0.09"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ================= J6 夹爪开合（不改变 TCP 位置，仅视觉/开合） ================= -->
  <joint name="gripper" type="revolute">
    <origin xyz="0 0 0.105300" rpy="0 0 0"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.174533" upper="1.745329" effort="10" velocity="10"/>
  </joint>

  <link name="moving_jaw_link">
    <visual>
      <origin xyz="0 -0.010 -0.036855" rpy="0 0 0"/>
      <geometry><box size="0.020 0.010 0.073710"/></geometry>
      <material name="jaw"><color rgba="0.95 0.75 0.20 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="3e-6" ixy="0" ixz="0" iyy="3e-6" iyz="0" izz="3e-6"/>
    </inertial>
  </link>

  <!-- ================= TCP（工具中心点 = 固件 FK 报告的点） ================= -->
  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_link"/>
    <child link="tcp_link"/>
  </joint>
  <link name="tcp_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.004"/></geometry>
      <material name="tcp"><color rgba="0.90 0.20 0.20 1"/></material>
    </visual>
  </link>

</robot>
