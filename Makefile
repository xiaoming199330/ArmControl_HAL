TARGET = ArmControl_HAL


######################################
# building variables
######################################
# debug build?
DEBUG = 1
# optimization
OPT = -Og


#######################################
# paths
#######################################
# 角色选择 (2026-09-11 主从臂):
#   make                -> 从臂固件 build/         ArmControl_HAL.bin
#   make ROLE=master    -> 主臂固件 build_master/  ArmControl_Master.bin
# 主臂 = 只读六轴 + 经 UART4 转发 0x13 流帧给从臂, 不跑轨迹/不禁拖拽。
# 两份固件共用同一棵源码树, 差异全部由 -DARM_MASTER_BUILD=1 包住。
ROLE ?= slave

# Build path
BUILD_DIR = build
ifeq ($(ROLE),master)
BUILD_DIR  = build_master
TARGET     = ArmControl_Master
ROLE_DEFS  = -DARM_MASTER_BUILD=1
else
ROLE_DEFS  =
endif

# UART4 主从链路波特率开关 (2026-09-11)。默认 115200;
# 物理层整改无效时可切到 19200/9600, 必须主从两块板用同一个值。
BAUD ?= 115200
BAUD_DEFS = -DUART4_BAUDRATE=$(BAUD)U

# ⚠ 波特率必须进 BUILD_DIR (2026-09-14 修):
# make 只看文件时间戳, CFLAGS 变了它不会重编。若共用同一个 build/,
# `make BAUD=19200` 会直接说"已是最新", 拷出来的 .bin 其实还是上一次的
# 波特率 —— 现场会以为"降到 19200 没改善", 结论直接跑偏。
# 默认 115200 保持 build/ 与 build_master/ 不变 (兼容文档与烧录脚本),
# 非默认波特率才加后缀。
ifneq ($(BAUD),115200)
BUILD_DIR := $(BUILD_DIR)_$(BAUD)
endif

# 控制台波特率开关 (2026-09-15, PC 中转降延迟):
#   make CBAUD=460800  -> 控制台 USART6 (PC6/PC7) 提速 4 倍
# ⚠ 与 BAUD 不是一回事! BAUD 改的是 UART4 主从链路; PC 中转路线根本不走 UART4,
#   走的是控制台 USART6 —— 所以降延迟要动的是 CBAUD。
# 收益: `#P` 单行 46 B, 115200 下 cprint 的 HAL_UART_Transmit 会**阻塞主循环 4.0 ms**,
#   460800 降到 1.0 ms。既减 3 ms 传输延迟, 又给主臂主循环腾出 4 倍余量
#   (直接抬高 sp 能达到的上限)。
# 现场三处必须同一个值: 主臂固件 / 从臂固件 / pc_relay.py --baud。
# 同样必须进 BUILD_DIR —— 否则又会出现"make 说已是最新, 拷出旧波特率固件"。
CBAUD ?= 115200
CBAUD_DEFS = -DCONSOLE_BAUD=$(CBAUD)U
ifneq ($(CBAUD),115200)
BUILD_DIR := $(BUILD_DIR)_c$(CBAUD)
endif

# 主从链路承载选择 (2026-09-14):
#   make                  -> UART4 (PA0/PA1) 二进制帧流, 默认
#   make LINK=can         -> CAN1 (PA11/PA12) @500k 差分总线
# 两块板必须用同一个值; 协议层 arm_control_protocol.c 两份完全相同。
# 同样必须进 BUILD_DIR, 否则 `make LINK=can` 会说"已是最新"并拷出 UART 版固件。
LINK ?= uart
ifeq ($(LINK),can)
LINK_DEFS = -DARM_LINK_CAN=1
else ifeq ($(LINK),net)
# 2026-09-20: 网口(UDP)承载。⚠ ETH_TXD1=PB13 与 CAN2_TX 冲突 ⇒ net 构建不初始化 CAN;
# PA1=ETH_REF_CLK 与 UART4_RX 冲突 ⇒ 主从链路(UART4)同样停用。
LINK_DEFS = -DARM_LINK_NET=1
else ifeq ($(LINK),both)
# 2026-09-22: **统一固件** —— 两条链路都编进去, 由 Flash 里的链路偏好
# (Core/Src/arm_link_cfg.c, 扇区11 区C) 在**启动时二选一**初始化。
#   · 串口(USART6) 永远常通, 也是切换链路唯一可靠的通道
#   · 物理互斥照旧(PB13=ETH_TXD1/CAN2_TX, PC4/PC5=RMII RXD0,RXD1/LED),
#     所以运行期**只初始化选中的那条**, 没选中的一次都不碰
#   · 切换 = `link can|net|off` → `link save` → RESET(**不支持热切换**)
#   · 出厂默认 = **全关**(FLASH 无记录时两条都不启用), 要开必须显式下命令
# ⚠ 单链路构建(net/can/uart)完全不受影响: 所有运行期分支都被 ARM_LINK_MULTI
#   守着, 旧构建走编译期 #if, 生成代码与改动前一致。
LINK_DEFS = -DARM_LINK_NET=1 -DARM_LINK_CAN=1 -DARM_LINK_MULTI=1
else
LINK_DEFS =
endif
ifneq ($(LINK),uart)
BUILD_DIR := $(BUILD_DIR)_$(LINK)
endif

# 舵机总线输出级 (2026-11-02, 0924AY):
#   默认  = **开漏单总线** (AF_OD) —— 已拆 74HC126D, TX/RX 短接成一根,
#           两条总线各 1kΩ 上拉到 3.3V。与舵机应答天然不打架。
#   BUS_PP=1 -> 回退**推挽 + 74HC126 方向切换** (AF_PP), 供仍挂 126 的旧板。
# ⚠ 两种模式都要求 BUILD_DIR 分开: 共用目录会让 make 说"已是最新",
#   从而拷出上一次输出级的固件 —— 烧进去表现就是"扫描 0/6"或"完全没反应"。
BUS_PP ?= 0

# 单总线开关 (2026-11-02, 0924AZ) —— 给"集成板已焊死 74HC126、拆不下来"的板子:
#   BUS_ONE=1 -> 6 轴全部走 UART5(Bus B), 启动即钉死 bus mode 2。
#   前提: 硬件把 74HC126 的 **1Y 与 3Y 短接**(两路门输出并成一条总线)。
#   ⚠ 隐含 BUS_PP=1(保留方向脚), 且 DIR_A 必须永久保持低电平 —— 固件侧
#      永不对 BUS_A 做事务, 所以那一路门始终高阻, 不会与门3 抢总线。
#   ⚠ 一旦用这个构建, 就**不能再烧双总线固件**: 双总线固件会拉高 DIR_A,
#      门1 与门3 同时驱动同一条线 = 推挽对撞。
BUS_ONE ?= 0
ifeq ($(BUS_ONE),1)
BUS_PP := 1
BUILD_DIR := $(BUILD_DIR)_one
endif

ifeq ($(BUS_PP),1)
BUS_DEFS = -DBUS_PP=1
ifneq ($(BUS_ONE),1)
BUILD_DIR := $(BUILD_DIR)_pp
endif
else
BUS_DEFS =
endif

ifeq ($(BUS_ONE),1)
BUS_DEFS += -DBUS_ONE=1
endif

# CAN1 引脚选择 (2026-09-14):
#   make LINK=can              -> PB8=PIN_RX / PB9=CAN1_TX, 与 .ioc 一致, 默认
#   make LINK=can CANPIN=pa    -> PA11/PA12 (F407 上同时是 USB_DM/DP)
# 两组都是 AF9。非默认值同样必须进 BUILD_DIR, 否则又会拷出"上一个引脚版本"的
# 固件去烧 —— 引脚错误在板上表现得和"线接错"一模一样, 排查会白烧几小时。
CANPIN ?= pb
ifeq ($(CANPIN),pa)
CANPIN_DEFS = -DARM_CAN_PINS_PA=1
else
CANPIN_DEFS =
endif
ifneq ($(CANPIN),pb)
BUILD_DIR := $(BUILD_DIR)_$(CANPIN)
endif

# 开机默认 CAN 接口 (2026-09-18 晚, 0918H):
#   make LINK=can              -> 默认 **CAN2** (PB12/PB13) —— 本板卡的实际接线, 烧完即用
#   make LINK=can CANIF=c1     -> 默认 CAN1 (只在这块板真的接在 CAN1 时才用)
# 为什么把默认从 CAN1 改成 CAN2: 烧录走整片擦除, 会把 Flash 扇区11 的 CAN 配置区一起抹掉
# ⇒ 每次烧完都回落到**编译期默认**。默认若是 CAN1, 就必须人工敲一次 `cx 2` 才能开始测,
# 漏了这一步的表现是"固件没问题、指纹也对、但上位机全部超时", 极易误判成烧坏了(红线 37)。
# 把默认改成硬件实况 ⇒ 烧完直接可用。运行期 `cx 1|2` 仍可随时切, `cx save` 落盘可覆盖本默认。
# 非默认值必须进 BUILD_DIR(理由同 CANPIN —— 否则 make 会说"已是最新"并拷出上一个接口版本的固件)。
CANIF ?= c2
ifeq ($(CANIF),c1)
CANIF_DEFS = -DARM_CAN_DEFAULT_IF_CAN1=1
else
CANIF_DEFS =
endif
ifneq ($(CANIF),c2)
BUILD_DIR := $(BUILD_DIR)_$(CANIF)
endif

