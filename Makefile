#######################################
# build the application
#######################################
# list of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
# list of ASM program objects
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASMM_SOURCES:.S=.o)))
vpath %.S $(sort $(dir $(ASMM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR) 
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@
$(BUILD_DIR)/%.o: %.S Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@
	
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@	
	
$(BUILD_DIR):
	mkdir $@		

#######################################
# flash  (STM32 内置 UART bootloader + stm32flash)
#   make flash                                   -> 烧从臂 build/ArmControl_HAL.bin
#   make flash ROLE=master                       -> 烧主臂 build_master/ArmControl_Master.bin
#   make flash PORT=COM5                         -> 指定串口 (默认 COM11)
#   make flash BINFILE=outputs/link_selftest/ArmControl_Master_115200.bin
#   make flash ROLE=master BAUD=19200            -> 烧 build_master_19200/ 里那份
# 现场步骤: BOOT0 拉高 -> 按一下 RESET -> 执行本目标 -> BOOT0 拉回低 -> 再按 RESET。
#######################################
PORT       ?= COM11
STM32FLASH ?= C:/STM32Tools/stm32flash.exe
BINFILE    ?= $(BUILD_DIR)/$(TARGET).bin

flash: all
	@test -f "$(BINFILE)" || { echo "找不到固件: $(BINFILE)"; exit 1; }
	@echo "烧录 $(BINFILE) -> $(PORT)   (BOOT0 已拉高? 已复位?)"
	$(STM32FLASH) -w "$(BINFILE)" -v -g 0x08000000 $(PORT)

#######################################
# clean up
#######################################
clean:
	-del /S /Q build 2>nul || rm -fR build 2>/dev/null || true
  
