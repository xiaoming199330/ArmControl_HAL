CFLAGS += $(MCU) $(C_DEFS) $(ROLE_DEFS) $(BAUD_DEFS) $(CBAUD_DEFS) $(LINK_DEFS) $(CANPIN_DEFS) $(CANIF_DEFS) $(BUS_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

